# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env ke repositori.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ternakku
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1h
# Daftar origin frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Batas percobaan login per 15 menit per IP (naikkan saat pengujian performa)
LOGIN_RATE_LIMIT_MAX=20
