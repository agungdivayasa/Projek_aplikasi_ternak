{
  "info": {
    "name": "TernakKu API",
    "description": "Koleksi request untuk RESTful API TernakKu. Jalankan Register lalu Login; token tersimpan otomatis ke variabel {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "livestockId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Putu Agus Wijana\",\n  \"email\": \"agus@ternakku.id\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agus@ternakku.id\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Livestock",
      "item": [
        {
          "name": "Tambah ternak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"livestockId\", pm.response.json().data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"species\": \"sapi\",\n  \"trackingMode\": \"individual\",\n  \"code\": \"SAPI-001\",\n  \"name\": \"Si Bali\",\n  \"breed\": \"Sapi Bali\",\n  \"sex\": \"jantan\",\n  \"quantity\": 1,\n  \"birthDate\": \"2025-03-15\",\n  \"acquisition\": {\n    \"type\": \"purchase\",\n    \"date\": \"2025-09-01\",\n    \"price\": 9500000\n  },\n  \"currentWeightKg\": 285,\n  \"healthStatus\": \"sehat\",\n  \"location\": \"Kandang B\",\n  \"speciesDetails\": {\n    \"isPregnant\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/livestock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock"
              ]
            }
          }
        },
        {
          "name": "Daftar ternak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livestock?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Cari dan filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livestock?search=bali&species=sapi&healthStatus=sehat&sortBy=name&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "bali"
                },
                {
                  "key": "species",
                  "value": "sapi"
                },
                {
                  "key": "healthStatus",
                  "value": "sehat"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Detail ternak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livestock/{{livestockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock",
                "{{livestockId}}"
              ]
            }
          }
        },
        {
          "name": "Ubah ternak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentWeightKg\": 300,\n  \"healthStatus\": \"sakit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/livestock/{{livestockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock",
                "{{livestockId}}"
              ]
            }
          }
        },
        {
          "name": "Hapus ternak",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livestock/{{livestockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livestock",
                "{{livestockId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Statistik dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "stats"
              ]
            }
          }
        }
      ]
    }
  ]
}