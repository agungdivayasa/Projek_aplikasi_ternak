{
  "name": "ternakku-backend",
  "version": "0.1.0",
  "description": "RESTful API Sistem Informasi Manajemen Peternakan Multi-Komoditas (TernakKu)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "seed": "node scripts/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/env.js"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
